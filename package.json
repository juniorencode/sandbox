{
  "name": "sandbox",
  "author": "Carlos Junior Ramos Vásquez",
  "description": "SandBox is a lightweight and versatile development environment designed to run and test JavaScript code quickly and efficiently. Its minimalist approach and intuitive interface make it an ideal tool for developers looking to experiment with code without complex configurations.",
  "version": "1.0.0",
  "type": "module",
  "main": "./main.cjs",
  "scripts": {
    "dev": "vite",
    "prebuild-vite": "node scripts/copy-wasm.cjs",
    "build-vite": "vite build && npm run build-runner",
    "build-runner": "vite build --config vite.node-runner.config.js",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify:app": "node --check scripts/verify-app.cjs && electron scripts/verify-app.cjs",
    "preview": "vite preview",
    "electron": "npm run build-vite && electron .",
    "build": "npm run build-vite && electron-builder"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "electron-updater": "^6.8.9",
    "esbuild-wasm": "^0.28.2",
    "magic-string": "^1.2.3",
    "monaco-editor": "^0.52.2",
    "prettier": "^3.9.6",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.5",
    "vitest": "^5.0.0"
  },
  "build": {
    "appId": "com.juniorencode.sandbox",
    "productName": "Sandbox",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "juniorencode",
        "repo": "sandbox"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "./icon.ico",
      "artifactName": "Sandbox-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": true,
      "installerIcon": "./icon.ico",
      "installerHeaderIcon": "./icon.ico",
      "deleteAppDataOnUninstall": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true
    }
  }
}
